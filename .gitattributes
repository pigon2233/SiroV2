# Auto detect text files and perform LF normalization
* text=auto

# Keep Linux entry points runnable after a Windows checkout.
scripts/* text eol=lf
*.cmd text eol=crlf

# Secret-gate pins hash exact bytes; keep them LF on Windows checkouts.
src/siro/services/agent/gpt_oss_profile.json text eol=lf
docs/runtime-evolution/** text eol=lf
