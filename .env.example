# SIRO does not require external credentials for the minimal profile.
# Provider-specific variable names will be added with their adapters in T07.
SIRO_PROFILE=minimal
SIRO_CONFIG_VERSION=1
# Optional existing local faster-whisper model directory; blank leaves STT unconfigured.
SIRO_WHISPER_MODEL_DIR=
# Optional validated local JSON reference-voice profile; no automatic voice fallback if invalid.
SIRO_QWEN_VOICE_PROFILE=
# Task routing is off by default. 1 keeps small talk on Ollama and sends reasoning to
# Claude, then Groq, then Ollama. See docs/MODEL_ROUTING.md.
SIRO_MODEL_ROUTER=0
# Claude calls allowed in each rolling 5-hour window. 0 disables Claude as a chat model.
SIRO_CLAUDE_BUDGET_CALLS=10
# How long to wait after a Claude CLI rate-limit error when the message has no reset time.
SIRO_CLAUDE_RATE_LIMIT_COOLDOWN_SECONDS=900
# Claude CLI timeout in seconds (10-240).
SIRO_CLAUDE_TIMEOUT_SECONDS=120
