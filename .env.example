# SIRO does not require external credentials for the minimal profile.
# Provider-specific variable names will be added with their adapters in T07.
SIRO_PROFILE=minimal
SIRO_CONFIG_VERSION=1
# Optional existing local faster-whisper model directory; blank leaves STT unconfigured.
SIRO_WHISPER_MODEL_DIR=
# Optional validated local JSON reference-voice profile; no automatic voice fallback if invalid.
SIRO_QWEN_VOICE_PROFILE=
