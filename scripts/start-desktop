#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_root"
if ! command -v gjs >/dev/null; then
  echo '桌寵需要 GJS、GTK3 和 WebKitGTK 4.1；尚未啟動。' >&2
  exit 2
fi
uv_command="$(command -v uv || true)"
if [[ -z "$uv_command" && -x "${HOME}/.local/bin/uv" ]]; then
  uv_command="${HOME}/.local/bin/uv"
fi
if [[ -z "$uv_command" ]]; then
  echo '桌寵需要 uv 與已安裝的專案 Python 環境；請先完成安裝。' >&2
  exit 2
fi
# Validate the existing backend without exposing its short-lived token.
export SIRO_DESKTOP_URL="${SIRO_DESKTOP_URL:-http://127.0.0.1:8000/desktop}"
"$uv_command" run --no-sync python - <<'CHECK'
import json, os, urllib.parse, urllib.request
url=os.environ["SIRO_DESKTOP_URL"]
p=urllib.parse.urlsplit(url)
if p.scheme != "http" or p.hostname not in {"127.0.0.1","localhost"} or p.path != "/desktop" or p.username or p.password or p.query or p.fragment:
    raise SystemExit("Desktop requires the exact loopback /desktop URL")
base=f"{p.scheme}://{p.netloc}"
try:
    request=urllib.request.Request(base+"/v1/session",data=b"",headers={"Origin":base},method="POST")
    with urllib.request.urlopen(request,timeout=5) as r: token=json.load(r)["token"]
    request=urllib.request.Request(base+"/v1/runtime",headers={"Authorization":"Bearer "+token})
    with urllib.request.urlopen(request,timeout=5) as r: runtime=json.load(r)
    if runtime.get("routes",{}).get("model","offline") == "offline":
        raise SystemExit("目前服務是離線示範；請先停止它，再用 scripts/start-companion 啟動正式 SIRO。")
    with urllib.request.urlopen(url,timeout=5) as r:
        if r.status != 200: raise SystemExit("Desktop renderer is unavailable")
except (OSError,KeyError,ValueError):
    raise SystemExit("尚未連接正式 SIRO 與 Live2D；請使用 scripts/start-companion。") from None
CHECK
if [[ ( "${XDG_SESSION_TYPE:-}" == wayland || ( -n "${WSL_DISTRO_NAME:-}" && -n "${WAYLAND_DISPLAY:-}" ) ) && -z "${SIRO_DESKTOP_BACKEND:-}" ]]; then
  # Application-only XWayland compatibility (also WSLg, which leaves XDG_SESSION_TYPE unset): a
  # native Wayland window cannot move itself, so strolls would only animate. The desktop session
  # is never changed.
  export GDK_BACKEND=x11
  echo 'SIRO 桌寵使用 XWayland 相容模式（不更改目前 Wayland 桌面）。'
elif [[ -n "${SIRO_DESKTOP_BACKEND:-}" ]]; then
  export GDK_BACKEND="$SIRO_DESKTOP_BACKEND"
fi
if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
  if ! command -v ibus >/dev/null || ! command -v ibus-daemon >/dev/null; then
    echo 'WSL 桌寵缺少注音輸入引擎；請在 Ubuntu 安裝 ibus 與 ibus-chewing。' >&2
    exit 2
  fi
  if ! ibus engine >/dev/null 2>&1; then
    ibus-daemon --daemonize --xim
  fi
  chewing_ready=0
  for ((attempt=0; attempt<20; attempt++)); do
    if ibus list-engine 2>/dev/null | grep '^  chewing -' >/dev/null && ibus engine chewing >/dev/null 2>&1; then
      chewing_ready=1
      break
    fi
    sleep .1
  done
  if ((chewing_ready == 0)); then
    echo '注音輸入引擎缺少或無法啟動；請檢查 Ubuntu 的 ibus、ibus-chewing 與 x11-xkb-utils。' >&2
    exit 2
  fi
  # Windows swallows the default <Super>space, so also switch engines with Ctrl+Space.
  gsettings set org.freedesktop.ibus.general preload-engines "['xkb:us::eng', 'chewing']" >/dev/null 2>&1 || true
  gsettings set org.freedesktop.ibus.general.hotkey triggers "['<Control>space', '<Super>space']" >/dev/null 2>&1 || true
  export GTK_IM_MODULE=ibus
  export XMODIFIERS=@im=ibus
fi
# Without a GPU path (WSLg's WebKit falls back to Mesa's llvmpipe) WebGL draws on the CPU with one
# thread per core; four are plenty for the pet and leave the rest to speech and transcription.
export LP_NUM_THREADS="${LP_NUM_THREADS:-4}"
# The host can die from a WebKit snapshot failure inside GJS that no script can catch. A crash
# (non-zero exit) relaunches it after 2 s, at most 5 times in 10 minutes; a clean exit, which is
# the owner closing it, or an interrupt does not.
starts=()
while true; do
  now=$SECONDS
  recent=()
  for started in "${starts[@]}"; do ((now - started < 600)) && recent+=("$started"); done
  starts=("${recent[@]}")
  if ((${#starts[@]} >= 5)); then echo 'SIRO 桌寵 10 分鐘內當機 5 次，不再自動重啟。' >&2; exit 1; fi
  starts+=("$now")
  if gjs -m desktop/host.js; then exit 0; else code=$?; fi
  if ((code == 130 || code == 143)); then exit "$code"; fi
  echo "SIRO 桌寵異常結束（代碼 $code），2 秒後重啟。" >&2
  sleep 2
done
