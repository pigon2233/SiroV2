+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "url",
+    [
+        "[https://example.com/](https://example.com/)",
+        "file:///tmp/canary",
+        "data:text/html,canary",
+        "http://credential-canary@example.com/",
