+        [
+            "node",
+            "-e",
+            setup
+            + initialize
+            + script
+            + helpers
+            + "\n(async () => {\n"
+            + checks
+            + "\n})().then(() => { finished = true; }, error => {"
+            + " finished = true; console.error(error); process.exitCode = 1; });",
