        return response(200, {token:`synthetic-${++nextToken}`, expires_in_seconds:300});
      }
      return fetchPlan ? fetchPlan(url, options) : response(200, {turn_id:'synthetic-turn'});
    };
    const snapshot = active_turns => ({
