          "default": "none"
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "project"
