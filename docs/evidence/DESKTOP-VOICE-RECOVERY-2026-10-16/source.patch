+                for line in headers.split(b"\r\n")
+                if line.lower().startswith(b"content-length:")
+            )
+            bodies.append(await reader.readexactly(length))
+            arrivals.append(asyncio.get_running_loop().time())
+            if len(bodies) == 1:
