+# Local Ubuntu 26.04 signed-package repair. Does not change Secure Boot or reboot.
+set -euo pipefail
+kernel_version="$(uname -r)"
+if [[ ! "$kernel_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+-[0-9]+-generic$ ]]; then
