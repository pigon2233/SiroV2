+@pytest.mark.asyncio
+async def test_successful_commit_reports_candidate_cleanup_refusal(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    store, source = await _databases(tmp_path)
+    directories = _Directories(
