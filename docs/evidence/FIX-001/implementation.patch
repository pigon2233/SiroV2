+class InterruptedIntentModel:
+    name = "interrupted-intent"
+
+    def __init__(self, failure: str, continuation: bool, partial_text: bool) -> None:
+        self.failure = failure
+        self.continuation = continuation
+        self.partial_text = partial_text
+        self.requests: list[ModelRequest] = []
+
+    async def stream(
+        self, request: ModelRequest, cancellation: CancellationToken
+    ) -> AsyncIterator[ModelChunk]:
+        self.requests.append(request)
+        round_number = len(self.requests)
+        if round_number > (2 if self.continuation else 1):
+            yield ModelChunk("text", "incorrect recovery")
+            return
+        if self.partial_text:
+            yield ModelChunk("text", "partial response")
+        yield ModelChunk(
+            "tool_request",
+            tool_call=ToolCall(f"intent-{round_number}", "computer.execute", {}),
+        )
+        if self.continuation and round_number == 1:
+            yield ModelChunk("finished")
+            return
+        if self.failure == "connection":
+            raise ConnectionError("synthetic provider disconnect")
+        if self.failure == "deadline":
+            await asyncio.sleep(60)
+        if self.failure == "timeout":
+            raise TimeoutError("synthetic provider timeout")
+        cancellation.cancel()
+        yield ModelChunk("finished")
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("profile", ["legacy", "candidate"])
+@pytest.mark.parametrize("continuation", [False, True])
+@pytest.mark.parametrize("failure", ["connection", "timeout", "deadline", "cancel"])
+@pytest.mark.parametrize("partial_text", [False, True])
+async def test_failed_generation_never_accepts_partial_tool_intent(
+    tmp_path: Path, profile: str, continuation: bool, failure: str, partial_text: bool
+) -> None:
+    import json
+    from typing import cast
+
+    from siro.core.conversation import TurnState
+    from siro.ports.models import LanguageModel
+
+    effects: list[object] = []
+
+    async def execute(arguments: dict[str, object]) -> object:
+        effects.append(arguments)
+        return {"confirmed": True}
+
+    model = InterruptedIntentModel(failure, continuation, partial_text)
+    store = SQLiteStore(tmp_path / "siro.db")
+    await store.initialize()
+    orchestrator = ToolOrchestrator(
+        SQLiteToolProposalRepository(store), {"computer.execute": execute}
+    )
+    hub = RecordingHub()
+    controller = IntegratedCompanion(
+        tmp_path,
+        model,
+        hub,
+        MinimalWebBodyAdapter(WebSocketBodyTransport()),
+        privacy=Privacy.LOCAL_ONLY,
+        tool_orchestrator=orchestrator,
+        runtime_profile=profile,
+        auto_authorize=lambda: True,
+    )
+    if failure == "deadline":
+        await controller._ensure_core()
+        assert controller._conversation is not None
+        controller._conversation._timeout = 0.05
+    await controller.respond("interrupted", "synthetic goal")
+    expected_state = "cancelled" if failure == "cancel" else "failed"
+    expected_error = {
+        "connection": "ConnectionError",
+        "timeout": "timeout",
+        "deadline": "timeout",
+        "cancel": None,
+    }[failure]
+    assert len(effects) == int(continuation)
+    assert len(model.requests) == 1 + int(continuation)
+    terminals = [e for e in hub.events if e["type"] == "assistant_terminal"]
+    assert len(terminals) == 1
+    assert terminals[0]["state"] == expected_state
+    assert terminals[0]["error"] == expected_error
+    readback = await controller.recovery_readback("interrupted")
+    assert readback is not None and readback["state"] == expected_state
+    assert readback["error"] == expected_error
+    rows = await store.run_transaction(
+        lambda c: c.execute("SELECT * FROM tool_proposals").fetchall()
+    )
+    assert len(rows) == int(continuation)
+    final = await store.run_transaction(
+        lambda c: c.execute("SELECT payload_json FROM agent_steps WHERE kind='final'").fetchone()
+    )
+    final_payload = json.loads(final[0])
+    assert final_payload["text"] == ("partial response" if partial_text else "")
+    assert final_payload["rejected_tool_calls"][0]["call_id"] == f"intent-{len(model.requests)}"
+    turns = await store.run_transaction(
+        lambda c: c.execute("SELECT state FROM turns ORDER BY rowid").fetchall()
+    )
+    assert turns[-1][0] == expected_state
+    if profile == "candidate":
+        assert readback["recovery_status"] == "terminal"
+        assert readback["tool_calls"] == int(continuation)
+        messages = cast(list[dict[str, object]], readback["messages"])
+        assert messages[-1]["content"] == final_payload["text"]
+        assert messages[-1]["tool_calls"] == []
+        calls = cast(list[dict[str, object]], readback["calls"])
+        assert len(calls) == int(continuation)
+        if continuation:
+            tool_messages = [m for m in messages if m["role"] == "tool"]
+            assert len(tool_messages) == 1
+            assert tool_messages[0]["tool_call_id"] == "intent-1"
+            assert json.loads(str(tool_messages[0]["content"])) == {"confirmed": True}
+
+        # Real reopen/reconciliation path; any provider/executor replay fails the test.
+        class NoReplay:
+            name = "no-replay"
+
+            async def stream(
+                self, request: ModelRequest, cancellation: CancellationToken
+            ) -> AsyncIterator[ModelChunk]:
+                raise AssertionError("restart must not call provider")
+                yield ModelChunk("finished")
+
+        restarted = IntegratedCompanion(
+            tmp_path,
+            cast(LanguageModel, NoReplay()),
+            RecordingHub(),
+            MinimalWebBodyAdapter(WebSocketBodyTransport()),
+            runtime_profile="candidate",
+            privacy=Privacy.LOCAL_ONLY,
+        )
+        await restarted.startup()
+        assert await restarted.recovery_readback("interrupted") == readback
+    assert TurnState(expected_state) in {TurnState.FAILED, TurnState.CANCELLED}
