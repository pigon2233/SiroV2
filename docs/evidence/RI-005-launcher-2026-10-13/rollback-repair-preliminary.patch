+                "FROM schema_migrations ORDER BY version LIMIT 4097"
+            ).fetchall()
+        finally:
+            connection.close()
+    except (OSError, sqlite3.Error):
+        return None
+    if not records or len(records) > 4096:
+        return None
+    if [record[0] for record in records] != list(range(1, len(records) + 1)):
+        return None
+    return len(records)
+
