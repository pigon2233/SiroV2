tests/integration/test_release_launch_selection.py:158: AssertionError
_ test_missing_or_unknown_actual_database_never_uses_constructor_schema_guess[missing] _

selection = SelectionFixture(manager=<siro.core.releases.ReleaseManager object at 0x75b687f94d00>, root=PosixPath('/tmp/pytest-of-...), configuration=PosixPath('/tmp/pytest-of-jasonliao/pytest-20/test_missing_or_unknown_actual0/synthetic-config.json'))
monkeypatch = <_pytest.monkeypatch.MonkeyPatch object at 0x75b687f94de0>
state = 'missing'

    @pytest.mark.parametrize("state", ["missing", "corrupt", "no-ledger", "no-database", "symlink"])
    def test_missing_or_unknown_actual_database_never_uses_constructor_schema_guess(
        selection: SelectionFixture, monkeypatch: pytest.MonkeyPatch, state: str
    ) -> None:
        if state == "missing":
            selection.database.unlink()
        elif state == "corrupt":
            selection.database.write_bytes(b"synthetic bytes that are not sqlite")
        elif state == "no-ledger":
            with closing(sqlite3.connect(selection.database)) as connection, connection:
                connection.execute("DROP TABLE schema_migrations")
        elif state == "symlink":
            actual = selection.database.with_name("synthetic-database-alias.sqlite3")
