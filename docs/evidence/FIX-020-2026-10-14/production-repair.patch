+    @staticmethod
+    def _digest_v2(directory: Path) -> str:
+        """Frame each file's identity; preserve Path.parts order from the legacy format."""
+        paths = sorted(path for path in directory.rglob("*") if path.is_file())
+        digest = hashlib.sha256(b"siro-release-source-v2\0")
+        digest.update(len(paths).to_bytes(8, "big"))
+        for path in paths:
+            name = path.relative_to(directory).as_posix().encode("utf-8")
+            data = path.read_bytes()
+            digest.update(len(name).to_bytes(8, "big"))
+            digest.update(name)
+            digest.update(len(data).to_bytes(8, "big"))
+            digest.update(data)
+        return digest.hexdigest()
+
