+
+    async def controlled(*_args: Any) -> dict[str, object]:
+        nonlocal calls
+        calls += 1
+        entered.set()
+        try:
+            return await asyncio.Future[dict[str, object]]()
+        finally:
+            await asyncio.sleep(0.02)
