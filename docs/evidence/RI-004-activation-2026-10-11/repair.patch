+async def registry_at(tmp_path: Path) -> tuple[SQLiteSkillRegistry, SQLiteStore]:
+    store = SQLiteStore(tmp_path / "synthetic.sqlite3")
+    await store.initialize()
+    return SQLiteSkillRegistry(store), store
