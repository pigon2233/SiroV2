+def test_candidate_close_failure_still_closes_activation_and_later_cleanup() -> None:
+    owner = ActivationService()
+    candidate = PreparedService()
+    candidate.close_error = ExecutionCleanupError("private-cleanup-canary")
+    stopped: list[str] = []
+
