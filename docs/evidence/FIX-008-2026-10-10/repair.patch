+        "--- a/src/siro/core/authorization.py\n+++ b/docs/other.txt\n"
+    )
+    check = (
+        "from pathlib import Path; "
+        "assert Path('docs/example.txt').read_text() == '++ b/docs/other.txt\\n'; "
+        "assert not Path('docs/other.txt').exists()"
