+
+
+def deletion(path: str) -> str:
+    return f"--- a/{path}\n+++ /dev/null\n@@ -1 +0,0 @@\n-VALUE = 1\n"
+
+
+def addition(path: str) -> str:
+    return f"--- /dev/null\n+++ b/{path}\n@@ -0,0 +1 @@\n+VALUE = 2\n"
